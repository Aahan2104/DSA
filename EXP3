#include <stdio.h>
#include <string.h>

#define MAX 100

struct Student
{
    int roll;
    char name[50];
    float marks;
};

struct Student s[MAX];
int n;

// Function to input student records
void input()
{
    int i;
    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nStudent %d\n", i + 1);

        printf("Enter Roll Number: ");
        scanf("%d", &s[i].roll);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }
}

// Function to display records
void display()
{
    int i;

    printf("\nStudent Database\n");
    printf("-------------------------------------------\n");
    printf("Roll\tName\tMarks\n");
    printf("-------------------------------------------\n");

    for(i = 0; i < n; i++)
    {
        printf("%d\t%s\t%.2f\n", s[i].roll, s[i].name, s[i].marks);
    }
}

// Linear Search
void linearSearch()
{
    int roll, i, found = 0;

    printf("Enter Roll Number to search: ");
    scanf("%d", &roll);

    for(i = 0; i < n; i++)
    {
        if(s[i].roll == roll)
        {
            printf("\nRecord Found\n");
            printf("Roll : %d\n", s[i].roll);
            printf("Name : %s\n", s[i].name);
            printf("Marks: %.2f\n", s[i].marks);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("Record Not Found\n");
}

// Insertion Sort
void insertionSort()
{
    int i, j;
    struct Student key;

    for(i = 1; i < n; i++)
    {
        key = s[i];
        j = i - 1;

        while(j >= 0 && s[j].roll > key.roll)
        {
            s[j + 1] = s[j];
            j--;
        }

        s[j + 1] = key;
    }

    printf("Records sorted using Insertion Sort.\n");
}

// Selection Sort
void selectionSort()
{
    int i, j, min;
    struct Student temp;

    for(i = 0; i < n - 1; i++)
    {
        min = i;

        for(j = i + 1; j < n; j++)
        {
            if(s[j].roll < s[min].roll)
                min = j;
        }

        temp = s[i];
        s[i] = s[min];
        s[min] = temp;
    }

    printf("Records sorted using Selection Sort.\n");
}

// Shell Sort
void shellSort()
{
    int gap, i, j;
    struct Student temp;

    for(gap = n / 2; gap > 0; gap /= 2)
    {
        for(i = gap; i < n; i++)
        {
            temp = s[i];

            for(j = i; j >= gap && s[j - gap].roll > temp.roll; j -= gap)
            {
                s[j] = s[j - gap];
            }

            s[j] = temp;
        }
    }

    printf("Records sorted using Shell Sort.\n");
}

// Binary Search
void binarySearch()
{
    int roll;
    int low = 0, high = n - 1, mid;

    printf("Enter Roll Number to search: ");
    scanf("%d", &roll);

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(s[mid].roll == roll)
        {
            printf("\nRecord Found\n");
            printf("Roll : %d\n", s[mid].roll);
            printf("Name : %s\n", s[mid].name);
            printf("Marks: %.2f\n", s[mid].marks);
            return;
        }
        else if(roll < s[mid].roll)
            high = mid - 1;
        else
            low = mid + 1;
    }

    printf("Record Not Found\n");
}

// Main Function
int main()
{
    int choice;

    input();

    while(1)
    {
        printf("\n========== MENU ==========\n");
        printf("1. Display Records\n");
        printf("2. Linear Search\n");
        printf("3. Insertion Sort\n");
        printf("4. Selection Sort\n");
        printf("5. Shell Sort\n");
        printf("6. Binary Search\n");
        printf("7. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                display();
                break;

            case 2:
                linearSearch();
                break;

            case 3:
                insertionSort();
                display();
                break;

            case 4:
                selectionSort();
                display();
                break;

            case 5:
                shellSort();
                display();
                break;

            case 6:
                printf("\nNote: Binary Search requires records to be sorted by Roll Number.\n");
                binarySearch();
                break;

            case 7:
                return 0;

            default:
                printf("Invalid Choice!\n");
        }
    }

    return 0;
}
