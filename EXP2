#include <stdio.h>

#define MAX 100

// Structure for sparse matrix
struct Sparse
{
    int row;
    int col;
    int value;
};

// Function to display sparse matrix in triplet form
void display(struct Sparse s[])
{
    int i;

    printf("\nRow\tColumn\tValue\n");
    for (i = 0; i <= s[0].value; i++)
    {
        printf("%d\t%d\t%d\n", s[i].row, s[i].col, s[i].value);
    }
}

// Simple Transpose
void transpose(struct Sparse a[], struct Sparse b[])
{
    int i, j, k = 1;

    b[0].row = a[0].col;
    b[0].col = a[0].row;
    b[0].value = a[0].value;

    for (i = 0; i < a[0].col; i++)
    {
        for (j = 1; j <= a[0].value; j++)
        {
            if (a[j].col == i)
            {
                b[k].row = a[j].col;
                b[k].col = a[j].row;
                b[k].value = a[j].value;
                k++;
            }
        }
    }
}

// Fast Transpose
void fastTranspose(struct Sparse a[], struct Sparse b[])
{
    int rowTerms[MAX], startingPos[MAX];
    int i, j, numCols, numTerms;

    numCols = a[0].col;
    numTerms = a[0].value;

    b[0].row = numCols;
    b[0].col = a[0].row;
    b[0].value = numTerms;

    if (numTerms > 0)
    {
        // Initialize rowTerms
        for (i = 0; i < numCols; i++)
            rowTerms[i] = 0;

        // Count elements in each column
        for (i = 1; i <= numTerms; i++)
            rowTerms[a[i].col]++;

        // Calculate starting position
        startingPos[0] = 1;

        for (i = 1; i < numCols; i++)
            startingPos[i] = startingPos[i - 1] + rowTerms[i - 1];

        // Place elements in correct position
        for (i = 1; i <= numTerms; i++)
        {
            j = startingPos[a[i].col];

            b[j].row = a[i].col;
            b[j].col = a[i].row;
            b[j].value = a[i].value;

            startingPos[a[i].col]++;
        }
    }
}

int main()
{
    struct Sparse a[MAX], b[MAX], c[MAX];
    int i, j, rows, cols, value;
    int k = 1;

    printf("Enter number of rows and columns: ");
    scanf("%d %d", &rows, &cols);

    printf("Enter the elements of the matrix:\n");

    // First row stores rows, columns and number of non-zero elements
    a[0].row = rows;
    a[0].col = cols;

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            scanf("%d", &value);

            if (value != 0)
            {
                a[k].row = i;
                a[k].col = j;
                a[k].value = value;
                k++;
            }
        }
    }

    a[0].value = k - 1;

    printf("\nOriginal Sparse Matrix (Triplet Form):");
    display(a);

    // Simple Transpose
    transpose(a, b);

    printf("\nSimple Transpose:");
    display(b);

    // Fast Transpose
    fastTranspose(a, c);

    printf("\nFast Transpose:");
    display(c);

    return 0;
}
